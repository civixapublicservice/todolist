generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id               String     @id @default(uuid())
  name             String
  email            String     @unique
  password         String
  resetToken       String?    @map("reset_token")
  resetTokenExpiry DateTime?  @map("reset_token_expiry")
  resetOtpAttempts Int        @default(0) @map("reset_otp_attempts")
  resetOtpCreatedAt DateTime? @map("reset_otp_created_at")
  createdAt        DateTime   @default(now()) @map("created_at")
  updatedAt        DateTime   @updatedAt @map("updated_at")
  todos            Todo[]
  activities       Activity[]
  notifications    Notification[]
  settings         Settings?

  @@map("users")
}

model Todo {
  id          String    @id @default(uuid())
  title       String
  description String    @default("")
  completed   Boolean   @default(false)
  priority    String    @default("MEDIUM")
  dueDate             DateTime? @map("due_date")
  reminderEnabled     Boolean   @default(false) @map("reminder_enabled")
  reminderTime        String?   @map("reminder_time")
  reminderType        String?   @map("reminder_type")
  reminderSent        Boolean   @default(false) @map("reminder_sent")
  reminderSentAt      DateTime? @map("reminder_sent_at")
  lastReminderAttempt DateTime? @map("last_reminder_attempt")
  reminderError       String?   @map("reminder_error")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, completed])
  @@map("todos")
}

model Activity {
  id        String   @id @default(uuid())
  action    String
  details   String
  createdAt DateTime @default(now()) @map("created_at")

  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("activities")
}

model Notification {
  id        String   @id @default(uuid())
  message   String
  type      String   @default("INFO")
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")

  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("notifications")
}

model Settings {
  id                String  @id @default(uuid())
  theme                     String  @default("system")
  timezone                  String  @default("UTC")
  emailAlerts               Boolean @default(true)
  pushNotifications         Boolean @default(true)
  globalEmailReminder       Boolean @default(true) @map("global_email_reminder")
  globalBrowserNotification Boolean @default(true) @map("global_browser_notification")
  defaultReminderTime       String  @default("15m") @map("default_reminder_time")
  reminderSound             Boolean @default(true) @map("reminder_sound")
  desktopNotification       Boolean @default(true) @map("desktop_notification")
  uiSounds                  Boolean @default(true) @map("ui_sounds")
  notificationSounds        Boolean @default(true) @map("notification_sounds")
  
  userId                    String  @unique @map("user_id")
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("settings")
}

model PendingRegistration {
  id          String   @id @default(uuid())
  name        String
  email       String   @unique
  password    String   
  otp         String   
  otpExpiry   DateTime @map("otp_expiry")
  otpAttempts Int      @default(0) @map("otp_attempts")
  createdAt   DateTime @default(now()) @map("created_at")
  
  @@map("pending_registrations")
}
